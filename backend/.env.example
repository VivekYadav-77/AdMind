GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_USE_MOCK_FALLBACK=true
FRONTEND_URL="http://localhost:5174" # URL used for verification and password reset links
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:5174" # Comma-separated CORS origins
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# Image Generation Providers
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
HUGGINGFACE_API_KEY=your_huggingface_key
POLLINATIONS_API_KEY=optional_pollinations_key
